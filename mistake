import { resolveLeadFromIntent } from "./resolveLeadFromIntent.js";

export async function handleIncomingMessage({ userId, phone, message, sendMessage }) {
  // 1. Evaluate intent
  const intent = await evaluateAutoReplyIntent({ userId, message });

  if (!intent.matched) {
    // No intent → no lead → no reply
    return { lead: null, autoReplied: false };
  }

  // 2. Resolve lead
  const lead = await resolveLeadFromIntent({
    userId,
    phone,
    message,
    intent,
  });

  // 3. Send auto-reply
  if (intent.replyContent) {
    await sendMessage(phone, intent.replyContent);
  }

  return { lead, autoReplied: true };
}

